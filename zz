import functools

__version__ = "0.3.1"

# --- Helpers ---

@functools.lru_cache()
def get_version():
    """Version string, plus the git commit (and -dirty if modified) when run from a checkout."""
    src = os.path.realpath(__file__)
    here = os.path.dirname(src)
    try:
        rev = subprocess.check_output(["git", "-C", here, "rev-parse", "--short", "HEAD"],
                                      encoding='utf-8', stderr=subprocess.DEVNULL).strip()
        dirty = subprocess.run(["git", "-C", here, "diff", "--quiet", "HEAD", "--", src],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode != 0
        return f"{__version__} ({rev}{'-dirty' if dirty else ''})"
    except (subprocess.CalledProcessError, OSError): return __version__

DURATION_UNITS = {'m': 60, 'h': 3600, 'd': 86400, 'w': 604800, 'y': 31536000}

def parse_duration(val):
    """Seconds for '90' (minutes), '30m', '1h', '7d', '2w', '1y'. Raises ValueError otherwise."""
    v = str(val).lower().strip()
    try:
        if v.isdigit(): secs = int(v) * 60
        else: secs = int(float(v[:-1]) * DURATION_UNITS[v[-1]])
    except (ValueError, KeyError, IndexError):
        raise ValueError(f"invalid duration '{val}' (use e.g. 30m, 1h, 7d, 2w, 1y)")
    if secs <= 0: raise ValueError(f"duration '{val}' must be greater than zero")
    return secs

def ds_duration(ds, prop, default):
    """Parsed zz:<prop> of a dataset; ValueError names the property if it is invalid."""
    try: return parse_duration(ds.props.get(f"zz:{prop}", default))
    except ValueError as e: raise ValueError(f"zz:{prop}: {e}")

def keep_min_arg(val):
    if not str(val).isdigit(): raise argparse.ArgumentTypeError(f"invalid keep_min '{val}' (use a whole number, 0 or more)")
    return str(val)

def duration_arg(val):
    try: parse_duration(val); return val
    except ValueError as e: raise argparse.ArgumentTypeError(str(e))

def human_duration(seconds):
    if seconds <= 0: return "0s"
    if seconds >= 86400 and seconds % 86400 == 0: return f"{int(seconds // 86400)}d"
    if seconds >= 3600 and seconds % 3600 == 0: return f"{int(seconds // 3600)}h"
    if seconds >= 60 and seconds % 60 == 0: return f"{int(seconds // 60)}m"
    if seconds >= 86400: return f"{round(seconds / 86400, 2)}d"
    if seconds >= 3600: return f"{round(seconds / 3600, 2)}h"
    return f"{int(seconds // 60)}m"

def snap_time(tag):
    """Creation timestamp embedded in a zz_auto_<epoch> tag, or 0."""
    try: return int(tag.rsplit('_', 1)[1])
    except (IndexError, ValueError): return 0

def parse_target(target):
    """Split 'host:pool/dataset' into (host, dataset). The remote dataset is exactly that path."""
    host, sep, path = target.partition(':')
    if not (sep and host and '/' in path.strip('/')):
        raise ValueError(f"Invalid remote '{target}': expected host:pool/dataset")
    return host, path.strip('/')

def fmt_age(seconds):
    return str(datetime.timedelta(seconds=max(0, int(seconds))))

def get_pv():
    path = subprocess.run(["which", "pv"], capture_output=True, text=True).stdout.strip()
    return path if path and os.path.exists(path) else None

# --- Core Logic ---

class ZzDataset:
    def __init__(self, name):
        self.name = name
        self.props = self._get_props()

    def _get_props(self):
        try:
            subprocess.check_call(["zfs", "list", self.name], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            # Only locally set properties: zz: values received from another host (e.g. on a
            # replica, or mid-restore) must not make a dataset look managed.
            cmd = ["zfs", "get", "all", "-s", "local", "-H", "-o", "property,value", self.name]
            res = subprocess.check_output(cmd, encoding='utf-8')
            pairs = [line.split('\t', 1) for line in res.splitlines() if '\t' in line]
            return {p: v for p, v in pairs if p.startswith("zz:")}
        except subprocess.CalledProcessError: return None  # dataset does not exist

    @property
    def target(self): return self.props.get("zz:target", "-")
    
    @property
    def last_sync(self):
        val = self.props.get("zz:last_sync", "0")
        return int(val) if val.isdigit() else 0

    @property
    def last_sent(self):
        val = self.props.get("zz:last_sent", "0")
        return int(val) if val.isdigit() else 0

    @property
    def last_error(self):
        val = self.props.get("zz:last_error", "-")
        return None if val == "-" else val

    def set_prop(self, prop, value):
        subprocess.run(["zfs", "set", f"zz:{prop}={value}", self.name], check=True)
        self.props[f"zz:{prop}"] = str(value)

    def record_error(self, msg):
        print(f"[!] {self.name}: {msg}", flush=True)
        try: self.set_prop("last_error", f"{int(time.time())} {msg}")
        except subprocess.CalledProcessError: pass

    def record_sent(self, tag):
        """Record the newest snapshot confirmed on the remote (by its embedded timestamp)."""
        ts = snap_time(tag)
        if ts and ts != self.last_sent: self.set_prop("last_sent", ts)
        if self.last_error: self.set_prop("last_error", "-")

def get_managed_datasets():
    try:
        cmd = ["zfs", "get", "-H", "-t", "filesystem", "-s", "local", "-o", "name", "zz:target"]
        res = subprocess.check_output(cmd, encoding='utf-8')
        return [line.strip() for line in res.strip().split('\n') if line.strip() and line.strip() != "NAME"]
    except (subprocess.CalledProcessError, OSError) as e:
        print(f"[!] Could not list managed datasets: {e}", file=sys.stderr, flush=True)
        return None

# --- Actions ---

def get_token(host, dataset):
    try:
        cmd = ["ssh", "-o", "BatchMode=yes", host, f"zfs get -H -o value receive_resume_token {dataset}"]
        res = subprocess.check_output(cmd, encoding='utf-8', stderr=subprocess.DEVNULL)
        return res.strip()
    except subprocess.CalledProcessError:
        return "-"  # no such dataset (e.g. before init) or unreachable; later steps report the latter

def is_token_active(host, dataset):
    t1 = get_token(host, dataset)
    if t1 == "-": return False
    time.sleep(3)
    t2 = get_token(host, dataset)
    return t1 != t2

def is_busy_local(dataset):
    """Local process check without the 'stray backslash' warning."""
    # We use the raw dataset name. grep -E handles slashes fine without escapes.
    check_cmd = f"ps -Aww -o args | grep -E 'zfs .*(send|recv|receive).* {dataset}(@| |$)' | grep -v grep"
    return subprocess.run(check_cmd, shell=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0

def run_transfer(send_cmd, recv_cmd):
    sys.stdout.flush()
    pv_path = get_pv()
    if pv_path:
        send_proc = subprocess.Popen(send_cmd, stdout=subprocess.PIPE)
        pv_proc = subprocess.Popen([pv_path, "-pterb"], stdin=send_proc.stdout, stdout=subprocess.PIPE)
        recv_proc = subprocess.Popen(recv_cmd, stdin=pv_proc.stdout)
        send_proc.stdout.close()
        pv_proc.stdout.close()
        recv_proc.communicate()
        return recv_proc.returncode
    else:
        send_proc = subprocess.Popen(send_cmd, stdout=subprocess.PIPE)
        recv_proc = subprocess.Popen(recv_cmd, stdin=send_proc.stdout)
        send_proc.stdout.close()
        recv_proc.communicate()
        return recv_proc.returncode

def run_prune(ds, remote_host=None, bridge=None, remote_path=None):
    """Destroy expired zz_auto_ snapshots on one side. Returns True if pruning failed."""
    is_remote = remote_host is not None
    label = f"remote ({remote_host})" if is_remote else "local"
    # Local pruning must know the latest snapshot on the remote. Anything at or newer
    # than it is unsent (or is the incremental base) and must never be destroyed.
    if not is_remote and not bridge:
        print(f"    [!] Skipping local prune: latest remote snapshot unknown.", flush=True)
        return False
    try:
        retention_sec = ds_duration(ds, "keep_remote" if is_remote else "keep_local", "7d")
        keep_min = int(ds.props.get("zz:keep_min", "10"))
    except ValueError as e:
        ds.record_error(f"Skipping {label} prune, invalid setting: {e}"); return True
    print(f"    [*] Pruning {label}...", flush=True)

    cmd = ["zfs", "list", "-t", "snapshot", "-H", "-o", "name,creation", "-p", "-S", "creation", remote_path if is_remote else ds.name]
    if is_remote: cmd = ["ssh", "-o", "BatchMode=yes", remote_host] + cmd
    try:
        res = subprocess.check_output(cmd, encoding='utf-8', stderr=subprocess.DEVNULL)
    except subprocess.CalledProcessError:
        ds.record_error(f"Could not list {label} snapshots for pruning."); return True
    snapshots = [(l.split('\t')[0], int(l.split('\t')[1])) for l in res.strip().split('\n') if "@zz_auto_" in l]
    if len(snapshots) <= keep_min: return False
    candidates = snapshots[keep_min:]
    if not is_remote:
        tags = [s[0].split('@')[1] for s in snapshots]
        if bridge not in tags:
            print(f"    [!] Skipping local prune: bridge @{bridge} not found locally.", flush=True)
            return False
        # snapshots is newest-first, so only those after the bridge are older than it
        candidates = snapshots[max(keep_min, tags.index(bridge) + 1):]
    now = int(time.time())
    failed = []
    for snap in [s[0] for s in candidates if (now - s[1]) > retention_sec]:
        print(f"        [-] Destroying {snap}", flush=True)
        del_cmd = ["zfs", "destroy", "-r", snap]
        if is_remote: del_cmd = ["ssh", "-o", "BatchMode=yes", remote_host] + del_cmd
        if subprocess.run(del_cmd).returncode != 0: failed.append(snap)
    if failed:
        ds.record_error(f"Could not destroy {len(failed)} {label} snapshot(s), e.g. {failed[0]}."); return True
    return False

def run_init(args):
    ds = ZzDataset(args.dataset)
    if ds.props is None:
        print(f"[!] Error: Dataset '{args.dataset}' not found.", flush=True); return True
    try: remote_host, remote_path = parse_target(args.remote)
    except ValueError as e: print(f"[!] {e}", flush=True); return True
    recv_cmd = ["ssh", remote_host, f"zfs recv -s -u {remote_path}"]

    if is_busy_local(args.dataset) or is_token_active(remote_host, remote_path):
        print(f"[*] {args.dataset}: Transfer already active. Skipping.", flush=True); return

    token = get_token(remote_host, remote_path)
    if token != "-":
        print(f"[*] Resuming initial sync...", flush=True)
        send_cmd = ["zfs", "send", "-v", "-t", token]
        if run_transfer(send_cmd, recv_cmd) == 0:
            ds.set_prop("target", args.remote); ds.set_prop("freq", args.freq); ds.set_prop("last_sync", int(time.time()))
            print("[+] Resume successful. Init complete.", flush=True)
            return
        print("[!] Transfer interrupted. Run again to resume.", flush=True); return True

    if subprocess.run(["ssh", "-o", "BatchMode=yes", remote_host, f"zfs list -H -o name {remote_path}"],
                      stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0:
        print(f"[!] {remote_path} already exists on {remote_host}. Refusing to overwrite it.", flush=True); return True
    parent = remote_path.rsplit('/', 1)[0]
    if '/' in parent:
        subprocess.run(["ssh", "-o", "BatchMode=yes", remote_host, f"zfs create -p {parent}"], check=True)

    ds.set_prop("target", args.remote); ds.set_prop("freq", args.freq)
    ds.set_prop("keep_local", args.keep_local); ds.set_prop("keep_remote", args.keep_remote); ds.set_prop("keep_min", args.keep_min)
    snap = f"zz_auto_{int(time.time())}"
    print(f"[*] Creating initial snapshot: {args.dataset}@{snap}", flush=True)
    subprocess.run(["zfs", "snapshot", "-r", f"{args.dataset}@{snap}"], check=True)

    print(f"[*] Starting initial transfer (Resumable)...", flush=True)
    send_cmd = ["zfs", "send", "-R", "-v", f"{args.dataset}@{snap}"]
    if run_transfer(send_cmd, recv_cmd) == 0:
        ds.set_prop("last_sync", int(time.time())); ds.record_sent(snap); print("[+] Init successful.", flush=True)
    else:
        print("[!] Transfer interrupted. Run again to resume.", flush=True); return True

def run_sync(args):
    print(f"--- zz {get_version()} sync @ {datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S')} ---", flush=True)
    names = [args.dataset] if args.dataset else get_managed_datasets()
    if names is None: return True
    failed = False
    for name in names:
        ds = ZzDataset(name)
        if not ds or not ds.props or ds.target == "-": continue
        
        try: remote_host, remote_path = parse_target(ds.target)
        except ValueError as e:
            ds.record_error(str(e)); failed = True; continue
        recv_cmd = ["ssh", remote_host, f"zfs recv -s -u {remote_path}"]

        # --- PHASE 1: THE SNAPSHOT (CATCH-UP LOGIC) ---
        now_ts = int(time.time())
        try: freq_sec = ds_duration(ds, "freq", "60m")
        except ValueError as e:
            ds.record_error(f"Invalid setting, skipping: {e}"); failed = True; continue
        
        # We check if it's time to take a NEW snapshot. 
        # We use a 30s buffer to help align with cron's 5m intervals.
        if (now_ts - ds.last_sync) >= (freq_sec - 30) or args.force:
            new_snap_tag = f"zz_auto_{now_ts}"
            print(f"[*] {name}: Taking scheduled snapshot @{new_snap_tag}...", flush=True)
            try:
                subprocess.run(["zfs", "snapshot", "-r", f"{ds.name}@{new_snap_tag}"], check=True)
                # We update last_sync NOW so we don't double-snap if the transfer takes a long time
                ds.set_prop("last_sync", now_ts)
            except subprocess.CalledProcessError:
                ds.record_error("Failed to take snapshot. Skipping transfer."); failed = True
                continue
        else:
            # If it's not time for a new snap, we might still have 'pending' ones from a previous 
            # run that was busy. We proceed to Phase 2 to check.
            pass

        # --- PHASE 2: THE TRANSFER (BUSY CHECKS) ---
        
        # Check if local ZFS processes are already touching this dataset
        if is_busy_local(name):
            print(f"[*] {name}: Active ZFS process detected. New snap is safe; will sync later.", flush=True)
            continue
        
        # Check if a remote resume token is currently growing (active transfer)
        if is_token_active(remote_host, remote_path):
            print(f"[*] {name}: Remote sync currently active. Skipping.", flush=True)
            continue

        # File-based lock to prevent two 'zz' instances from colliding
        lock_path = f"/tmp/zz_{name.replace('/', '_')}.lock"
        lock_f = open(lock_path, 'w')
        try: 
            fcntl.flock(lock_f, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except IOError:
            print(f"[*] {name}: Local file lock held. Skipping.", flush=True)
            lock_f.close(); continue 

        # --- PHASE 3: DELTA DISCOVERY ---

        # Handle interrupted/resumable transfers first
        token = get_token(remote_host, remote_path)
        if token != "-":
            print(f"[*] {name}: Resuming interrupted transfer...", flush=True)
            send_cmd = ["zfs", "send", "-v", "-t", token]
            if run_transfer(send_cmd, recv_cmd) != 0:
                ds.record_error("Resume of interrupted transfer failed."); failed = True
                lock_f.close(); continue

        # Identify the "Bridge" (latest common snapshot)
        try:
            cmd = ["ssh", "-o", "BatchMode=yes", remote_host, f"zfs list -t snapshot -H -S creation -o name {remote_path}"]
            res = subprocess.check_output(cmd, encoding='utf-8')
            remote_snaps = [l.strip().split('@')[1] for l in res.strip().split('\n') if "@zz_auto_" in l]
            if not remote_snaps:
                ds.record_error("No automated snapshots found on remote."); failed = True
                lock_f.close(); continue
            bridge = remote_snaps[0]
        except subprocess.CalledProcessError:
            ds.record_error(f"Could not retrieve snapshot list for {remote_path} on {remote_host}."); failed = True
            lock_f.close(); continue

        # Build the list of snapshots that exist locally but not on remote
        cmd = ["zfs", "list", "-t", "snapshot", "-H", "-o", "name", "-s", "creation", ds.name]
        local_list = subprocess.check_output(cmd, encoding='utf-8').strip().split('\n')
        
        pending = []
        found_bridge = False
        for s in local_list:
            if '@' not in s: continue
            tag = s.split('@')[1]
            if tag == bridge: 
                found_bridge = True
                continue
            if found_bridge and "@zz_auto_" in s:
                pending.append(tag)

        if not found_bridge:
            ds.record_error(f"Latest remote snapshot @{bridge} does not exist locally. "
                            f"Incremental sync is impossible; manual intervention required.")
            failed = True
            lock_f.close(); continue

        # --- PHASE 4: THE SEND ---
        current_base = bridge
        send_ok = True
        if not pending:
            print(f"[*] {name}: Remote is already up to date.", flush=True)
        else:
            for next_tag in pending:
                print(f"    [*] Sending {name}: @{current_base} -> @{next_tag}", flush=True)
                send_cmd = ["zfs", "send", "-R", "-v", "-i", f"@{current_base}", f"{ds.name}@{next_tag}"]
                
                if run_transfer(send_cmd, recv_cmd) != 0:
                    send_ok = False
                    break
                current_base = next_tag

        # Record replication progress; a failure is recorded after, so it isn't cleared
        ds.record_sent(current_base)
        if not send_ok:
            ds.record_error(f"Transfer failed at @{next_tag}. Will resume later."); failed = True

        # Always try to prune after a successful check/sync
        # current_base is the newest snapshot confirmed on the remote
        if run_prune(ds, bridge=current_base): failed = True
        if run_prune(ds, remote_host, remote_path=remote_path): failed = True
        
        fcntl.flock(lock_f, fcntl.LOCK_UN)
        lock_f.close()
    return failed

def run_forget(args):
    ds = ZzDataset(args.dataset)
    if not ds or not ds.props: return
    for prop in list(ds.props.keys()): subprocess.run(["zfs", "inherit", prop, ds.name])

def zz_snaps(dataset, host=None):
    """zz_auto_ snapshot tags of exactly this dataset, newest first. Raises on failure."""
    cmd = ["zfs", "list", "-t", "snapshot", "-H", "-S", "creation", "-o", "name", dataset]
    if host: cmd = ["ssh", "-o", "BatchMode=yes", host] + cmd
    res = subprocess.check_output(cmd, encoding='utf-8', stderr=subprocess.DEVNULL)
    return [l.split('@', 1)[1] for l in res.splitlines() if "@zz_auto_" in l]

def snap_guid(snapshot, host=None):
    cmd = ["zfs", "get", "-H", "-o", "value", "guid", snapshot]
    if host: cmd = ["ssh", "-o", "BatchMode=yes", host] + cmd
    try: return subprocess.check_output(cmd, encoding='utf-8', stderr=subprocess.DEVNULL).strip()
    except subprocess.CalledProcessError: return None

def run_restore(args):
    try: remote_host, remote_ds = parse_target(args.remote)
    except ValueError as e: print(f"[!] {e}", flush=True); return True
    local_ds = args.local_dataset
    recv_cmd = ["zfs", "recv", "-s", "-u", local_ds]
    print(f"[*] Starting Recovery: {args.remote} -> {local_ds}", flush=True)

    try: remote_snaps = zz_snaps(remote_ds, remote_host)
    except subprocess.CalledProcessError:
        print(f"[!] Could not list snapshots of {remote_ds} on {remote_host}.", flush=True); return True
    if not remote_snaps:
        print(f"[!] No zz_auto_ snapshots found on {remote_host}:{remote_ds}.", flush=True); return True
    latest = remote_snaps[0]
    try:
        res = subprocess.check_output(["ssh", "-o", "BatchMode=yes", remote_host,
                                       f"zfs get all -H -o property,value {remote_ds}"], encoding='utf-8')
        pairs = [l.split('\t', 1) for l in res.splitlines() if '\t' in l]
        remote_props = {p: v for p, v in pairs if p.startswith("zz:") and not p.startswith("zz:last_")}
    except subprocess.CalledProcessError:
        print(f"[!] Could not read properties of {remote_ds} on {remote_host}.", flush=True); return True

    # 1. Finish an interrupted receive, if there is one
    try: token = subprocess.check_output(["zfs", "get", "-H", "-o", "value", "receive_resume_token", local_ds],
                                         encoding='utf-8', stderr=subprocess.DEVNULL).strip()
    except subprocess.CalledProcessError: token = "-"
    exists = subprocess.run(["zfs", "list", local_ds], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0
    if token != "-":
        print(f"[*] Resuming interrupted restore...", flush=True)
        if run_transfer(["ssh", remote_host, f"zfs send -v -t {token}"], recv_cmd) != 0:
            print("[!] Restore interrupted again. Run the same command to resume.", flush=True); return True
    elif exists:
        # Only continue into an existing dataset if it is an unfinished restore from this remote
        local_snaps = zz_snaps(local_ds)
        if ZzDataset(local_ds).props or not local_snaps or \
           snap_guid(f"{local_ds}@{local_snaps[0]}") != snap_guid(f"{remote_ds}@{local_snaps[0]}", remote_host):
            print(f"[!] {local_ds} already exists and is not a partial restore from {args.remote}. "
                  f"Refusing to overwrite it; rename or destroy it, or restore to another name.", flush=True)
            return True
        print(f"[*] Continuing partial restore (have @{local_snaps[0]})...", flush=True)
    else:
        mode = "latest snapshot only" if args.latest else "full history"
        print(f"[*] Restoring @{latest} ({mode})...", flush=True)
        send = f"zfs send -v {remote_ds}@{latest}" if args.latest else f"zfs send -R -v {remote_ds}@{latest}"
        if run_transfer(["ssh", remote_host, send], recv_cmd) != 0:
            print("[!] Restore interrupted. Run the same command to resume.", flush=True); return True

    # 2. A resumed -R stream only completes the snapshot in flight; send whatever is still missing
    local_snaps = zz_snaps(local_ds)
    if local_snaps and local_snaps[0] != latest:
        if local_snaps[0] not in remote_snaps:
            print(f"[!] Local @{local_snaps[0]} not found on remote; cannot continue.", flush=True); return True
        flags = "-v -i" if args.latest else "-R -v -I"
        print(f"[*] Catching up @{local_snaps[0]} -> @{latest}...", flush=True)
        if run_transfer(["ssh", remote_host, f"zfs send {flags} @{local_snaps[0]} {remote_ds}@{latest}"], recv_cmd) != 0:
            print("[!] Restore interrupted. Run the same command to resume.", flush=True); return True
    if not zz_snaps(local_ds) or zz_snaps(local_ds)[0] != latest:
        print(f"[!] Restore incomplete: @{latest} not present locally.", flush=True); return True

    # 3. Make it a live, managed primary again (unless another dataset already replicates there)
    subprocess.run(["zfs", "set", "readonly=off", local_ds]); subprocess.run(["zfs", "set", "canmount=on", local_ds])
    owners = [n for n in (get_managed_datasets() or []) if n != local_ds and ZzDataset(n).target == args.remote]
    if not owners:
        ds = ZzDataset(local_ds)
        for pk, pv in remote_props.items(): ds.set_prop(pk.split(':', 1)[1], pv)
        ds.set_prop("target", args.remote); ds.set_prop("last_sync", int(time.time())); ds.record_sent(latest)
    res = subprocess.check_output(["zfs", "list", "-H", "-o", "name,canmount,mounted", "-r", local_ds], encoding='utf-8')
    for n, canmount, mounted in (l.split('\t') for l in res.splitlines() if l):
        if canmount == "off" or mounted == "yes": continue
        if subprocess.run(["zfs", "mount", n], stderr=subprocess.DEVNULL).returncode != 0:
            print(f"    [!] Could not mount {n}; check its mountpoint.", flush=True)
    if owners:
        print(f"[+] Restore complete at @{latest}. {owners[0]} already replicates to {args.remote}, "
              f"so {local_ds} was left unmanaged (use 'zz init' to replicate it elsewhere).", flush=True)
    else:
        print(f"[+] Restore complete at @{latest}. Replication to {args.remote} will resume on the next sync.", flush=True)

def replication_state(ds, now):
    """(status, lag_seconds or None). Lag is the age of the newest snapshot confirmed on the remote."""
    try: freq_sec = ds_duration(ds, "freq", "60m")
    except ValueError: return "ERROR", None
    if ds.last_sync == 0: return "INIT", None
    if ds.last_error: return "ERROR", (now - ds.last_sent if ds.last_sent else None)
    if not ds.last_sent: return "UNKNOWN", None
    lag = now - ds.last_sent
    if lag > max(86400, 4 * freq_sec): return "STALLED", lag
    # One interval plus cron granularity is normal; allow two before flagging
    if lag > 2 * freq_sec + 300: return "LAGGING", lag
    return "OK", lag

def run_status(args):
    print(f"zz {get_version()}\n", flush=True)
    managed = get_managed_datasets()
    if managed is None: return True
    if not managed: print("No managed datasets.", flush=True); return
    print(f"{'DATASET':<20} | {'STATUS':<8} | {'LAST SNAP':<18} | {'LAG':<16} | {'NEXT SNAP'}", flush=True)
    print("-" * 90, flush=True)
    unhealthy, errors = False, []
    now = int(time.time())
    for name in managed:
        ds = ZzDataset(name)
        status, lag = replication_state(ds, now)
        lag_str = fmt_age(lag) if lag is not None else "-"
        if ds.last_sync == 0:
            last_str, next_run = "NEVER", "PENDING"
        else:
            gap = now - ds.last_sync
            last_str = "UNKNOWN" if gap > 86400 * 365 else fmt_age(gap) + " ago"
            try:
                freq_sec = ds_duration(ds, "freq", "60m")
                next_run = "DUE NOW" if gap >= freq_sec else fmt_age(freq_sec - gap)
            except ValueError as e:
                next_run = "-"
                if not ds.last_error: errors.append(f"  {name}: {e}")
        print(f"{name:<20} | {status:<8} | {last_str:<18} | {lag_str:<16} | {next_run}", flush=True)
        if status not in ("OK", "INIT", "UNKNOWN"): unhealthy = True
        if ds.last_error:
            ts, _, msg = ds.last_error.partition(' ')
            when = datetime.datetime.fromtimestamp(int(ts)).strftime('%Y-%m-%d %H:%M:%S') if ts.isdigit() else "?"
            errors.append(f"  {name} @ {when}: {msg}")
    if errors: print("\nLast errors:\n" + "\n".join(errors), flush=True)
    return unhealthy

def run_meta(args):
    ds = ZzDataset(args.dataset)
    if not ds or not ds.props: return
    print(f"\n[ zz Contract: {args.dataset} ]", flush=True)
    print(f"{'DESCRIPTION':<22} | {'KEY':<12} | {'VALUE'}", flush=True)
    print("-" * 65, flush=True)
    fields = [('Remote Target','target','zz:target'), ('Sync Frequency','freq','zz:freq'), 
              ('Local Retention','keep_local','zz:keep_local'), ('Remote Retention','keep_remote','zz:keep_remote'),
              ('Safety Floor (Min)','keep_min','zz:keep_min')]
    for d, k, p in fields:
        val = ds.props.get(p, "-")
        if k in ['freq', 'keep_local', 'keep_remote'] and val != "-":
            try: val = human_duration(parse_duration(val))
            except ValueError: val = f"{val} (INVALID)"
        print(f"{d:<22} | {k:<12} | {val}", flush=True)

def run_set(args):
    ds = ZzDataset(args.dataset)
    if ds.props is None:
        print(f"[!] Error: Dataset '{args.dataset}' not found.", flush=True); return True
    try:
        if args.prop in ('freq', 'keep_local', 'keep_remote'): parse_duration(args.value)
        elif args.prop == 'keep_min': keep_min_arg(args.value)
        elif args.prop == 'target': parse_target(args.value)
    except (ValueError, argparse.ArgumentTypeError) as e:
        print(f"[!] Not updated: {e}", flush=True); return True
    ds.set_prop(args.prop, args.value); print(f"[*] Updated {args.prop} to {args.value}", flush=True)

def run_abort(args):
    ds = ZzDataset(args.dataset)
    if not ds or ds.target == "-": return
    remote_host, remote_path = parse_target(ds.target)
    subprocess.run(["ssh", remote_host, f"zfs recv -A {remote_path}"])
    print("[+] Resume token cleared.", flush=True)

def main():
    parser = argparse.ArgumentParser(prog='zz', description='Zeasy: Simplified ZFS Replication', formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="Durations: 30m, 1h, 7d, 2w, 1y (a bare number means minutes).\n\n"
               "Examples:\n  zz init tank/data backup:pool/data --freq 1h\n  zz status\n  zz restore backup:pool/data tank/data")
    parser.add_argument('--version', action='version', version=f"zz {get_version()}")
    subparsers = parser.add_subparsers(title='Commands', dest='command', metavar='<command>')
    pi = subparsers.add_parser('init', help='Start replicating a dataset: <dataset> <host:pool/dataset> [--freq] [--keep-local] [--keep-remote] [--keep-min]')
    pi.add_argument('dataset'); pi.add_argument('remote')
    pi.add_argument('--freq', default='60m', type=duration_arg); pi.add_argument('--keep-local', default='7d', type=duration_arg)
    pi.add_argument('--keep-remote', default='30d', type=duration_arg); pi.add_argument('--keep-min', default='10', type=keep_min_arg)
    pi.set_defaults(func=run_init)
    ps = subparsers.add_parser('sync', help='Snapshot if due and send to the remote: [dataset] [--force]'); ps.add_argument('dataset', nargs='?'); ps.add_argument('--force', action='store_true'); ps.set_defaults(func=run_sync)
    subparsers.add_parser('status', help='Replication health of all managed datasets').set_defaults(func=run_status)
    pm = subparsers.add_parser('meta', help='Show a dataset\'s settings: <dataset>'); pm.add_argument('dataset'); pm.set_defaults(func=run_meta)
    pset = subparsers.add_parser('set', help='Change a setting: <dataset> <prop> <value>'); pset.add_argument('dataset'); pset.add_argument('prop', choices=['target', 'freq', 'keep_local', 'keep_remote', 'keep_min']); pset.add_argument('value'); pset.set_defaults(func=run_set)
    pa = subparsers.add_parser('abort', help='Discard an interrupted transfer on the remote: <dataset>'); pa.add_argument('dataset'); pa.set_defaults(func=run_abort)
    pf = subparsers.add_parser('forget', help='Stop managing a dataset (data is kept): <dataset>'); pf.add_argument('dataset'); pf.set_defaults(func=run_forget)
    pr = subparsers.add_parser('restore', help='Recreate a dataset from the remote: <host:pool/dataset> <dataset> [--latest]'); pr.add_argument('remote'); pr.add_argument('local_dataset'); pr.add_argument('--latest', action='store_true'); pr.set_defaults(func=run_restore)
    args = parser.parse_args()
    if not hasattr(args, 'func'): parser.print_help(); return
    if args.func(args): sys.exit(1)

if __name__ == "__main__": main()
