# Root-only lock directory (not /tmp, where another user could plant a symlink)
LOCK_DIR = os.environ.get("ZZ_LOCK_DIR", "/run/zz")

# --- Helpers ---

@functools.lru_cache()
def get_version():
    """Version string, plus the git commit (and -dirty if modified) when run from a checkout."""
    src = os.path.realpath(__file__)
    here = os.path.dirname(src)
    try:
        rev = subprocess.check_output(["git", "-C", here, "rev-parse", "--short", "HEAD"],
                                      encoding='utf-8', stderr=subprocess.DEVNULL).strip()
        dirty = subprocess.run(["git", "-C", here, "diff", "--quiet", "HEAD", "--", src],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode != 0
        return f"{__version__} ({rev}{'-dirty' if dirty else ''})"
    except (subprocess.CalledProcessError, OSError): return __version__

DURATION_UNITS = {'m': 60, 'h': 3600, 'd': 86400, 'w': 604800, 'y': 31536000}

def parse_duration(val):
    """Seconds for '90' (minutes), '30m', '1h', '7d', '2w', '1y'. Raises ValueError otherwise."""
    v = str(val).lower().strip()
    try:
        if v.isdigit(): secs = int(v) * 60
        else: secs = int(float(v[:-1]) * DURATION_UNITS[v[-1]])
    except (ValueError, KeyError, IndexError):
        raise ValueError(f"invalid duration '{val}' (use e.g. 30m, 1h, 7d, 2w, 1y)")
    if secs <= 0: raise ValueError(f"duration '{val}' must be greater than zero")
    return secs

def ds_duration(ds, prop, default):
    """Parsed zz:<prop> of a dataset; ValueError names the property if it is invalid."""
    try: return parse_duration(ds.props.get(f"zz:{prop}", default))
    except ValueError as e: raise ValueError(f"zz:{prop}: {e}")

# zfs send flags zz may use; chosen once at init and stored in zz:send_flags, because
# changing them mid-replication can make incremental receives fail.
SEND_FLAGS = ("-L", "-c", "-e", "-w")
# Received on the replica by init: don't auto-mount at the primary's mountpoint, don't allow writes
REPLICA_RECV_OPTS = "-o canmount=noauto -o readonly=on"

def parse_send_flags(val):
    """zz:send_flags value -> list of zfs send flags. Absent/'none' means none (pre-0.5 replications)."""
    if val is None or str(val).strip() in ("", "none", "-"): return []
    flags = str(val).split()
    bad = [f for f in flags if f not in SEND_FLAGS]
    if bad: raise ValueError(f"invalid send flags {' '.join(bad)} (allowed: {' '.join(SEND_FLAGS)}, or none)")
    return flags

def default_send_flags(dataset):
    """-w (raw) for encrypted datasets, so the replica never needs the key; otherwise -L -c.
    -e is left out: its streams can't be received into an encrypted dataset on the replica."""
    enc = subprocess.run(["zfs", "get", "-H", "-o", "value", "encryption", dataset],
                         capture_output=True, text=True).stdout.strip()
    return "-w" if enc not in ("", "off", "-") else "-L -c"

def send_flags_arg(val):
    try: return " ".join(parse_send_flags(val))
    except ValueError as e: raise argparse.ArgumentTypeError(str(e))

def keep_min_arg(val):
    if not str(val).isdigit(): raise argparse.ArgumentTypeError(f"invalid keep_min '{val}' (use a whole number, 0 or more)")
    return str(val)

def duration_arg(val):
    try: parse_duration(val); return val
    except ValueError as e: raise argparse.ArgumentTypeError(str(e))

def human_duration(seconds):
    if seconds <= 0: return "0s"
    if seconds >= 86400 and seconds % 86400 == 0: return f"{int(seconds // 86400)}d"
    if seconds >= 3600 and seconds % 3600 == 0: return f"{int(seconds // 3600)}h"
    if seconds >= 60 and seconds % 60 == 0: return f"{int(seconds // 60)}m"
    if seconds >= 86400: return f"{round(seconds / 86400, 2)}d"
    if seconds >= 3600: return f"{round(seconds / 3600, 2)}h"
    return f"{int(seconds // 60)}m"

def snap_time(tag):
    """Creation timestamp embedded in a zz_auto_<epoch> tag, or 0."""
    try: return int(tag.rsplit('_', 1)[1])
    except (IndexError, ValueError): return 0

def parse_target(target):
    """Split 'host:pool/dataset' into (host, dataset). The remote dataset is exactly that path."""
    host, sep, path = target.partition(':')
    if not (sep and host and '/' in path.strip('/')):
        raise ValueError(f"Invalid remote '{target}': expected host:pool/dataset")
    return host, path.strip('/')

def human_bytes(n):
    for unit in ("B", "K", "M", "G", "T"):
        if n < 1024 or unit == "T": return f"{n:.0f}{unit}" if unit == "B" else f"{n:.1f}{unit}"
        n /= 1024

def fmt_gap(seconds):
    """Compact interval: '1:00', '0:05', '2d 3:15'."""
    m = (max(0, int(seconds)) + 30) // 60  # nearest minute; the 30s schedule allowance otherwise shows 0:59
    d, m = divmod(m, 1440)
    return (f"{d}d " if d else "") + f"{m // 60}:{m % 60:02d}"

def fmt_age(seconds):
    return str(datetime.timedelta(seconds=max(0, int(seconds))))

def get_pv():
    return shutil.which("pv")

def open_lock(name, kind):
    """Open (creating if needed) the lock file for a dataset, refusing to follow symlinks."""
    os.makedirs(LOCK_DIR, mode=0o700, exist_ok=True)
    path = os.path.join(LOCK_DIR, f"{name.replace('/', '_')}.{kind}.lock")
    return os.fdopen(os.open(path, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600), 'r+')

def managed_dataset(name):
    """ZzDataset for a managed dataset, or None after printing why not."""
    ds = ZzDataset(name)
    if ds.props is None: print(f"[!] Error: Dataset '{name}' not found.", flush=True); return None
    if ds.target == "-": print(f"[!] Error: Dataset '{name}' is not managed by zz.", flush=True); return None
    return ds

# --- Core Logic ---

class ZzDataset:
    def __init__(self, name):
        self.name = name
        self.props = self._get_props()

    def _get_props(self):
        try:
            subprocess.check_call(["zfs", "list", self.name], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            # Only locally set properties: zz: values received from another host (e.g. on a
            # replica, or mid-restore) must not make a dataset look managed.
            cmd = ["zfs", "get", "all", "-s", "local", "-H", "-o", "property,value", self.name]
            res = subprocess.check_output(cmd, encoding='utf-8')
            pairs = [line.split('\t', 1) for line in res.splitlines() if '\t' in line]
            return {p: v for p, v in pairs if p.startswith("zz:")}
        except subprocess.CalledProcessError: return None  # dataset does not exist

    @property
    def target(self): return self.props.get("zz:target", "-")
    
    @property
    def last_sync(self):
        val = self.props.get("zz:last_sync", "0")
        return int(val) if val.isdigit() else 0

    @property
    def last_sent(self):
        val = self.props.get("zz:last_sent", "0")
        return int(val) if val.isdigit() else 0

    @property
    def last_error(self):
        val = self.props.get("zz:last_error", "-")
        return None if val == "-" else val

    def set_prop(self, prop, value):
        subprocess.run(["zfs", "set", f"zz:{prop}={value}", self.name], check=True)
        self.props[f"zz:{prop}"] = str(value)

    def record_error(self, msg):
        print(f"[!] {self.name}: {msg}", flush=True)
        try: self.set_prop("last_error", f"{int(time.time())} {msg}")
        except subprocess.CalledProcessError: pass

    def record_sent(self, tag):
        """Record the newest snapshot confirmed on the remote (by its embedded timestamp)."""
        ts = snap_time(tag)
        if ts and ts != self.last_sent: self.set_prop("last_sent", ts)
        if self.last_error: self.set_prop("last_error", "-")

def get_managed_datasets():
    try:
        cmd = ["zfs", "get", "-H", "-t", "filesystem", "-s", "local", "-o", "name", "zz:target"]
        res = subprocess.check_output(cmd, encoding='utf-8')
        return [line.strip() for line in res.strip().split('\n') if line.strip() and line.strip() != "NAME"]
    except (subprocess.CalledProcessError, OSError) as e:
        print(f"[!] Could not list managed datasets: {e}", file=sys.stderr, flush=True)
        return None

# --- Actions ---

def get_token(host, dataset):
    try:
        cmd = ["ssh", "-o", "BatchMode=yes", host, f"zfs get -H -o value receive_resume_token {dataset}"]
        res = subprocess.check_output(cmd, encoding='utf-8', stderr=subprocess.DEVNULL)
        return res.strip()
    except subprocess.CalledProcessError:
        return "-"  # no such dataset (e.g. before init) or unreachable; later steps report the latter

def is_token_active(host, dataset):
    t1 = get_token(host, dataset)
    if t1 == "-": return False
    time.sleep(3)
    t2 = get_token(host, dataset)
    return t1 != t2

def is_busy_local(dataset):
    """True if a local zfs send/receive process is working on this dataset."""
    pattern = re.compile(r'(^|[\s/])zfs\s.*(send|recv|receive).*\s' + re.escape(dataset) + r'(@|\s|$)')
    procs = subprocess.run(["ps", "-Aww", "-o", "args="], capture_output=True, text=True).stdout
    return any(pattern.search(line) for line in procs.splitlines())

# zfs send -R notes on stderr that are expected during incremental sends and not worth logging
SEND_NOISE = ("because it was created after the destination snapshot",)

def run_transfer(send_cmd, recv_cmd, summary=None):
    """Pipe send into receive. Non-zero if either side failed.

    Without summary: zfs's own progress output (and pv, if installed) is shown as-is.
    With summary: the stream is relayed and counted, and one line reports the result.
    """
    sys.stdout.flush()
    if summary is None:
        send_proc = subprocess.Popen(send_cmd, stdout=subprocess.PIPE)
        procs, stream = [send_proc], send_proc.stdout
        pv_path = get_pv()
        if pv_path:
            pv_proc = subprocess.Popen([pv_path, "-pterb"], stdin=stream, stdout=subprocess.PIPE)
            stream.close(); procs.append(pv_proc); stream = pv_proc.stdout
        recv_proc = subprocess.Popen(recv_cmd, stdin=stream)
        stream.close()
        recv_proc.wait()
        for p in procs: p.wait()
        return recv_proc.returncode or send_proc.returncode

    send_proc = subprocess.Popen(send_cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    recv_proc = subprocess.Popen(recv_cmd, stdin=subprocess.PIPE)
    err = []
    reader = threading.Thread(target=lambda: err.append(send_proc.stderr.read()))
    reader.start()
    total, start = 0, time.monotonic()
    try:
        while True:
            chunk = send_proc.stdout.read(1 << 20)
            if not chunk: break
            recv_proc.stdin.write(chunk); total += len(chunk)
    except BrokenPipeError: pass  # receiver exited early; its exit status reports why
    finally:
        try: recv_proc.stdin.close()
        except BrokenPipeError: pass
        send_proc.stdout.close()
    recv_proc.wait(); send_proc.wait(); reader.join()
    for line in b"".join(err).decode(errors="replace").splitlines():
        if line.strip() and not any(n in line for n in SEND_NOISE): print(f"    {line}", flush=True)
    rc = recv_proc.returncode or send_proc.returncode
    if rc == 0:
        print(f"    [+] Sent {summary}: {human_bytes(total)} in {time.monotonic() - start:.1f}s", flush=True)
    return rc

HOLD_TAG = "zz_bridge"

def zfs_on(host, *args):
    """argv for a zfs command, locally or on host over ssh."""
    return (["ssh", "-o", "BatchMode=yes", host] if host else []) + ["zfs"] + list(args)

def held_bridges(dataset, host=None):
    """Snapshot names (after '@') of this dataset carrying a zz_bridge hold."""
    res = subprocess.check_output(zfs_on(host, "list", "-H", "-t", "snapshot", "-o", "name,userrefs", "-d", "1", dataset),
                                  encoding='utf-8', stderr=subprocess.DEVNULL)
    busy = [n for n, refs in (l.split('\t') for l in res.splitlines() if l) if refs != "0"]
    if not busy: return set()
    res = subprocess.check_output(zfs_on(host, "holds", "-H", *busy), encoding='utf-8', stderr=subprocess.DEVNULL)
    return {l.split('\t')[0].split('@', 1)[1] for l in res.splitlines() if l.split('\t')[1:2] == [HOLD_TAG]}

def pin_bridge(dataset, bridge, host=None):
    """Hold the bridge snapshot (and its children's) so it can't be destroyed by accident, then
    release zz's hold on any earlier bridge. Holding first means a common snapshot is always
    protected. With bridge=None, just releases. Returns an error message or None."""
    side = host or "local"
    try:
        held = held_bridges(dataset, host)
        if bridge and bridge not in held:
            subprocess.run(zfs_on(host, "hold", "-r", HOLD_TAG, f"{dataset}@{bridge}"), check=True,
                           stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
        for old in held - {bridge}:
            subprocess.run(zfs_on(host, "release", "-r", HOLD_TAG, f"{dataset}@{old}"), check=True,
                           stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
    except subprocess.CalledProcessError as e:
        detail = (e.stderr or b"").decode(errors="replace").strip() if isinstance(e.stderr, bytes) else ""
        return f"Could not update {HOLD_TAG} hold on {side} {dataset}" + (f": {detail}" if detail else ".")
    return None

def replica_noauto(host, path):
    """Set canmount=noauto on replica descendants that would auto-mount. The receive-time
    -o canmount=noauto only reaches the top dataset, and canmount isn't inherited."""
    try:
        res = subprocess.check_output(zfs_on(host, "list", "-H", "-o", "name,canmount", "-r", path),
                                      encoding='utf-8', stderr=subprocess.DEVNULL)
    except subprocess.CalledProcessError: return
    for name, canmount in (l.split('\t') for l in res.splitlines() if l):
        if name != path and canmount == "on":
            subprocess.run(zfs_on(host, "set", "canmount=noauto", name), stderr=subprocess.DEVNULL)

def tidy_stale_children(ds, host, rpath):
    """Children deleted on the primary linger on the replica (zz never receives with -F) and stay
    recoverable until their snapshots age out; then remove them, so retention decides when
    deleted data leaves the backup. Records what remains in zz:stale_children. Returns an error
    message or None."""
    try:
        remote = subprocess.check_output(zfs_on(host, "list", "-H", "-o", "name", "-r", rpath),
                                         encoding='utf-8', stderr=subprocess.DEVNULL).split()
        local = {n[len(ds.name):] for n in subprocess.check_output(
            ["zfs", "list", "-H", "-o", "name", "-r", ds.name], encoding='utf-8').split()}
    except subprocess.CalledProcessError:
        return f"Could not compare the dataset trees on each side."
    gone = [r for r in remote if r != rpath and r[len(rpath):] not in local]
    top = [g for g in gone if not any(g.startswith(o + "/") for o in gone)]
    remaining, err = [], None
    for child in top:
        snaps = subprocess.run(zfs_on(host, "list", "-H", "-t", "snapshot", "-o", "name", "-r", child),
                               capture_output=True, text=True).stdout.split()
        if snaps:
            remaining.append(child[len(rpath) + 1:]); continue
        print(f"        [-] Removing {child} from the replica: deleted on the primary and aged out of retention", flush=True)
        if subprocess.run(zfs_on(host, "destroy", "-r", child)).returncode != 0:
            remaining.append(child[len(rpath) + 1:]); err = f"Could not remove {child} from the replica."
    val = ",".join(remaining) or "-"
    if ds.props.get("zz:stale_children", "-") != val: ds.set_prop("stale_children", val)
    return err

def run_prune(ds, remote_host=None, bridge=None, remote_path=None):
    """Destroy expired zz_auto_ snapshots on one side. Returns True if pruning failed."""
    is_remote = remote_host is not None
    label = f"remote ({remote_host})" if is_remote else "local"
    # Local pruning must know the latest snapshot on the remote. Anything at or newer
    # than it is unsent (or is the incremental base) and must never be destroyed.
    if not is_remote and not bridge:
        print(f"    [!] Skipping local prune: latest remote snapshot unknown.", flush=True)
        return False
    try:
        retention_sec = ds_duration(ds, "keep_remote" if is_remote else "keep_local", "7d")
        keep_min = int(ds.props.get("zz:keep_min", "10"))
    except ValueError as e:
        ds.record_error(f"Skipping {label} prune, invalid setting: {e}"); return True
    print(f"    [*] Pruning {label}...", flush=True)

    cmd = ["zfs", "list", "-t", "snapshot", "-H", "-o", "name,creation", "-p", "-S", "creation", remote_path if is_remote else ds.name]
    if is_remote: cmd = ["ssh", "-o", "BatchMode=yes", remote_host] + cmd
    try:
        res = subprocess.check_output(cmd, encoding='utf-8', stderr=subprocess.DEVNULL)
    except subprocess.CalledProcessError:
        ds.record_error(f"Could not list {label} snapshots for pruning."); return True
    snapshots = [(l.split('\t')[0], int(l.split('\t')[1])) for l in res.strip().split('\n') if "@zz_auto_" in l]
    if len(snapshots) <= keep_min: return False
    candidates = snapshots[keep_min:]
    if not is_remote:
        tags = [s[0].split('@')[1] for s in snapshots]
        if bridge not in tags:
            print(f"    [!] Skipping local prune: bridge @{bridge} not found locally.", flush=True)
            return False
        # snapshots is newest-first, so only those after the bridge are older than it
        candidates = snapshots[max(keep_min, tags.index(bridge) + 1):]
    elif bridge:
        # The remote's bridge is normally its newest snapshot, but keep_min may be 0
        candidates = [c for c in candidates if c[0].split('@', 1)[1] != bridge]
    now = int(time.time())
    failed = []
    for snap in [s[0] for s in candidates if (now - s[1]) > retention_sec]:
        print(f"        [-] Destroying {snap}", flush=True)
        del_cmd = ["zfs", "destroy", "-r", snap]
        if is_remote: del_cmd = ["ssh", "-o", "BatchMode=yes", remote_host] + del_cmd
        if subprocess.run(del_cmd).returncode != 0: failed.append(snap)
    if failed:
        ds.record_error(f"Could not destroy {len(failed)} {label} snapshot(s), e.g. {failed[0]}."); return True
    return False

def sync_scheduled():
    """True if root's crontab, /etc/crontab or /etc/cron.d mentions 'zz ... sync'."""
    pattern = re.compile(r'(^|[\s/])zz\s+sync\b')
    texts = [subprocess.run(["crontab", "-l"], capture_output=True, text=True).stdout]
    for path in ["/etc/crontab"] + [os.path.join("/etc/cron.d", f) for f in (os.listdir("/etc/cron.d") if os.path.isdir("/etc/cron.d") else [])]:
        try:
            with open(path) as f: texts.append(f.read())
        except OSError: pass
    return any(pattern.search(line) for t in texts for line in t.splitlines() if not line.lstrip().startswith("#"))

def init_done(dataset, target):
    """Success summary: this dataset's status row and what to do next."""
    print(f"\n[+] Init successful: {dataset} -> {target}\n", flush=True)
    print_status_table([dataset])
    print("\nNext steps:", flush=True)
    if not sync_scheduled():
        print("  * Schedule syncs; no cron entry running 'zz sync' was found. For example, in root's crontab:\n"
              "      */5 * * * * /usr/local/bin/zz sync >> /var/log/zz.out 2>&1", flush=True)
    print("  * Check on it any time with: zz status   (or: zz snaps)", flush=True)

def init_failed(reason, hint=None):
    print(f"\n[!] Init failed: {reason}", flush=True)
    if hint: print(f"    {hint}", flush=True)
    return True

def run_init(args):
    ds = ZzDataset(args.dataset)
    if ds.props is None: return init_failed(f"dataset '{args.dataset}' not found.")
    try: remote_host, remote_path = parse_target(args.remote)
    except ValueError as e: return init_failed(str(e))
    recv_cmd = ["ssh", remote_host, f"zfs recv -s -u {REPLICA_RECV_OPTS} {remote_path}"]

    if is_busy_local(args.dataset) or is_token_active(remote_host, remote_path):
        return init_failed(f"a transfer for {args.dataset} is already running.", "Wait for it to finish, then run init again.")

    token = get_token(remote_host, remote_path)
    if token != "-":
        print(f"[*] Resuming initial sync...", flush=True)
        send_cmd = ["zfs", "send", "-v", "-t", token]
        if run_transfer(send_cmd, recv_cmd) != 0:
            return init_failed("the initial transfer was interrupted again.", "Run the same command again to resume it.")
        ds.set_prop("target", args.remote); ds.set_prop("freq", args.freq); ds.set_prop("last_sync", int(time.time()))
        try: snaps = zz_snaps(remote_path, remote_host)
        except subprocess.CalledProcessError: snaps = []
        if snaps:
            ds.record_sent(snaps[0])
            for host, path in ((None, args.dataset), (remote_host, remote_path)):
                err = pin_bridge(path, snaps[0], host)
                if err: print(f"    [!] {err}", flush=True)
        init_done(args.dataset, args.remote)
        return

    probe = subprocess.run(["ssh", "-o", "BatchMode=yes", remote_host, f"zfs list -H -o name {remote_path}"],
                           capture_output=True, text=True)
    if probe.returncode == 0:
        return init_failed(f"{remote_path} already exists on {remote_host}; refusing to overwrite it.",
                           "Choose a different remote path, or remove the existing one first.")
    if probe.returncode == 255:   # ssh's own failure code
        return init_failed(f"could not reach {remote_host} over ssh.",
                           f"Check with: ssh {remote_host} zfs list   (key-based login is required)")
    parent = remote_path.rsplit('/', 1)[0]
    if '/' in parent:
        mk = subprocess.run(["ssh", "-o", "BatchMode=yes", remote_host, f"zfs create -p {parent}"], capture_output=True, text=True)
        if mk.returncode != 0:
            return init_failed(f"could not create {parent} on {remote_host}: {mk.stderr.strip()}")

    ds.set_prop("target", args.remote); ds.set_prop("freq", args.freq)
    ds.set_prop("keep_local", args.keep_local); ds.set_prop("keep_remote", args.keep_remote); ds.set_prop("keep_min", args.keep_min)
    flags = args.send_flags if args.send_flags is not None else default_send_flags(args.dataset)
    ds.set_prop("send_flags", flags or "none")
    snap = f"zz_auto_{int(time.time())}"
    print(f"[*] Creating initial snapshot: {args.dataset}@{snap}", flush=True)
    mk = subprocess.run(["zfs", "snapshot", "-r", f"{args.dataset}@{snap}"], capture_output=True, text=True)
    if mk.returncode != 0:
        return init_failed(f"could not create the initial snapshot: {mk.stderr.strip()}")

    print(f"[*] Starting initial transfer (Resumable)...", flush=True)
    print(f"    send flags: {flags or 'none'}", flush=True)
    send_cmd = ["zfs", "send", "-R", "-v"] + parse_send_flags(flags) + [f"{args.dataset}@{snap}"]
    if run_transfer(send_cmd, recv_cmd) != 0:
        return init_failed("the initial transfer did not complete.",
                           "If it was interrupted, run the same command again to resume it.")
    ds.set_prop("last_sync", int(time.time())); ds.record_sent(snap)
    replica_noauto(remote_host, remote_path)
    for host, path in ((None, args.dataset), (remote_host, remote_path)):
        err = pin_bridge(path, snap, host)
        if err: print(f"    [!] {err}", flush=True)
    init_done(args.dataset, args.remote)

def run_sync(args):
    print(f"--- zz {get_version()} sync @ {datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S')} ---", flush=True)
    names = [args.dataset] if args.dataset else get_managed_datasets()
    if names is None: return True
    failed = False
    for name in names:
        if args.dataset:
            ds = managed_dataset(name)
            if not ds: failed = True; continue
        else:
            ds = ZzDataset(name)
            if not ds.props or ds.target == "-": continue

        try: remote_host, remote_path = parse_target(ds.target)
        except ValueError as e:
            ds.record_error(str(e)); failed = True; continue
        recv_cmd = ["ssh", remote_host, f"zfs recv -s -u {remote_path}"]
        try: send_flags = parse_send_flags(ds.props.get("zz:send_flags"))
        except ValueError as e:
            ds.record_error(f"zz:send_flags: {e}"); failed = True; continue

        # --- PHASE 1: THE SNAPSHOT (CATCH-UP LOGIC) ---
        # Taken even while a transfer is running (it is sent later), so this uses its own
        # short lock rather than the transfer lock. Re-read settings once the lock is held,
        # in case another run just took the snapshot.
        with open_lock(name, "snap") as snap_lock:
            fcntl.flock(snap_lock, fcntl.LOCK_EX)
            ds = ZzDataset(name)
            now_ts = int(time.time())
            try: freq_sec = ds_duration(ds, "freq", "60m")
            except ValueError as e:
                ds.record_error(f"Invalid setting, skipping: {e}"); failed = True; continue

            # The 30s allowance keeps a snapshot due on this cron run from slipping to the next.
            due = (now_ts - ds.last_sync) >= (freq_sec - 30)
            snapped = due or args.force
            if snapped:
                new_snap_tag = f"zz_auto_{now_ts}"
                kind = "scheduled" if due else "on-demand (--now)"
                print(f"[*] {name}: Taking {kind} snapshot @{new_snap_tag}...", flush=True)
                try:
                    subprocess.run(["zfs", "snapshot", "-r", f"{ds.name}@{new_snap_tag}"], check=True)
                    # last_sync anchors the schedule, so only a due snapshot moves it; an on-demand
                    # one leaves the cadence alone. Set it now so a long transfer can't double-snap.
                    if due: ds.set_prop("last_sync", now_ts)
                except subprocess.CalledProcessError:
                    ds.record_error("Failed to take snapshot. Skipping transfer."); failed = True
                    continue
            # Otherwise there may still be pending snapshots from a run that was busy.

        # --- PHASE 2: THE TRANSFER (BUSY CHECKS) ---
        
        # Check if local ZFS processes are already touching this dataset
        if is_busy_local(name):
            print(f"[*] {name}: Active ZFS process detected. New snap is safe; will sync later.", flush=True)
            continue
        
        # Check if a remote resume token is currently growing (active transfer)
        if is_token_active(remote_host, remote_path):
            print(f"[*] {name}: Remote sync currently active. Skipping.", flush=True)
            continue

        # File-based lock to prevent two 'zz' instances from colliding
        lock_f = open_lock(name, "sync")
        try:
            fcntl.flock(lock_f, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            print(f"[*] {name}: Local file lock held. Skipping.", flush=True)
            lock_f.close(); continue 

        # --- PHASE 3: DELTA DISCOVERY ---

        # Handle interrupted/resumable transfers first
        token = get_token(remote_host, remote_path)
        if token != "-":
            print(f"[*] {name}: Resuming interrupted transfer...", flush=True)
            send_cmd = ["zfs", "send", "-t", token]
            if run_transfer(send_cmd, recv_cmd, summary=f"{name} (resumed)") != 0:
                ds.record_error("Resume of interrupted transfer failed."); failed = True
                lock_f.close(); continue

        # Identify the "Bridge" (latest common snapshot)
        try:
            cmd = ["ssh", "-o", "BatchMode=yes", remote_host, f"zfs list -t snapshot -H -S creation -o name {remote_path}"]
            res = subprocess.check_output(cmd, encoding='utf-8')
            remote_snaps = [l.strip().split('@')[1] for l in res.strip().split('\n') if "@zz_auto_" in l]
            if not remote_snaps:
                ds.record_error("No automated snapshots found on remote."); failed = True
                lock_f.close(); continue
            bridge = remote_snaps[0]
        except subprocess.CalledProcessError:
            ds.record_error(f"Could not retrieve snapshot list for {remote_path} on {remote_host}."); failed = True
            lock_f.close(); continue

        # Build the list of snapshots that exist locally but not on remote
        cmd = ["zfs", "list", "-t", "snapshot", "-H", "-o", "name", "-s", "creation", ds.name]
        try: local_list = subprocess.check_output(cmd, encoding='utf-8').strip().split('\n')
        except subprocess.CalledProcessError:
            ds.record_error("Could not list local snapshots."); failed = True
            lock_f.close(); continue

        pending = []
        found_bridge = False
        for s in local_list:
            if '@' not in s: continue
            tag = s.split('@')[1]
            if tag == bridge: 
                found_bridge = True
                continue
            if found_bridge and "@zz_auto_" in s:
                pending.append(tag)

        if not found_bridge:
            ds.record_error(f"Latest remote snapshot @{bridge} does not exist locally. "
                            f"Incremental sync is impossible; manual intervention required.")
            failed = True
            lock_f.close(); continue

        # --- PHASE 4: THE SEND ---
        current_base = bridge
        send_ok = True
        if not pending:
            if snapped:
                print(f"[*] {name}: Remote is already up to date.", flush=True)
            else:
                # Nothing was due, so changes since the last snapshot haven't been captured yet
                next_in = fmt_age(max(0, ds.last_sync + freq_sec - int(time.time())))
                print(f"[*] {name}: Remote is up to date. Next snapshot in {next_in} "
                      f"(use --now to snapshot immediately).", flush=True)
        else:
            for next_tag in pending:
                # Announce the send before it starts, so a long transfer doesn't look like a hang
                print(f"    [>] Sending {name} @{current_base} -> @{next_tag}...", flush=True)
                send_cmd = ["zfs", "send", "-R"] + send_flags + ["-i", f"@{current_base}", f"{ds.name}@{next_tag}"]
                if run_transfer(send_cmd, recv_cmd, summary=f"{name} @{current_base} -> @{next_tag}") != 0:
                    send_ok = False
                    break
                current_base = next_tag

        # New child datasets may have arrived with these sends
        if current_base != bridge: replica_noauto(remote_host, remote_path)

        # Record replication progress; a failure is recorded after, so it isn't cleared
        ds.record_sent(current_base)
        if not send_ok:
            ds.record_error(f"Transfer failed at @{next_tag}. Will resume later."); failed = True

        # current_base is the newest snapshot confirmed on the remote: protect it on both sides
        for host, path in ((None, ds.name), (remote_host, remote_path)):
            err = pin_bridge(path, current_base, host)
            if err: ds.record_error(err); failed = True

        # Always try to prune after a successful check/sync
        if run_prune(ds, bridge=current_base): failed = True
        if run_prune(ds, remote_host, bridge=current_base, remote_path=remote_path): failed = True
        err = tidy_stale_children(ds, remote_host, remote_path)
        if err: ds.record_error(err); failed = True
        
        fcntl.flock(lock_f, fcntl.LOCK_UN)
        lock_f.close()
    return failed

def run_forget(args):
    ds = managed_dataset(args.dataset)
    if not ds: return True
    # Release zz's holds first, so nothing is left mysteriously undeletable
    failed = False
    try: remote = parse_target(ds.target)
    except ValueError: remote = None
    for host, path in ((None, ds.name),) + (((remote[0], remote[1]),) if remote else ()):
        err = pin_bridge(path, None, host)
        if err: print(f"    [!] {err} Release it with: zfs release -r {HOLD_TAG} <snapshot>", flush=True); failed = True
    for prop in list(ds.props.keys()): subprocess.run(["zfs", "inherit", prop, ds.name])
    print(f"[+] {ds.name} is no longer managed by zz. Its data and snapshots were kept.", flush=True)
    return failed

def zz_snaps(dataset, host=None):
    """zz_auto_ snapshot tags of exactly this dataset, newest first. Raises on failure."""
    cmd = ["zfs", "list", "-t", "snapshot", "-H", "-S", "creation", "-o", "name", dataset]
    if host: cmd = ["ssh", "-o", "BatchMode=yes", host] + cmd
    res = subprocess.check_output(cmd, encoding='utf-8', stderr=subprocess.DEVNULL)
    return [l.split('@', 1)[1] for l in res.splitlines() if "@zz_auto_" in l]

def snap_guid(snapshot, host=None):
    cmd = ["zfs", "get", "-H", "-o", "value", "guid", snapshot]
    if host: cmd = ["ssh", "-o", "BatchMode=yes", host] + cmd
    try: return subprocess.check_output(cmd, encoding='utf-8', stderr=subprocess.DEVNULL).strip()
    except subprocess.CalledProcessError: return None

def run_restore(args):
    try: remote_host, remote_ds = parse_target(args.remote)
    except ValueError as e: print(f"[!] {e}", flush=True); return True
    local_ds = args.local_dataset
    recv_cmd = ["zfs", "recv", "-s", "-u", local_ds]
    print(f"[*] Starting Recovery: {args.remote} -> {local_ds}", flush=True)

    try: remote_snaps = zz_snaps(remote_ds, remote_host)
    except subprocess.CalledProcessError:
        print(f"[!] Could not list snapshots of {remote_ds} on {remote_host}.", flush=True); return True
    if not remote_snaps:
        print(f"[!] No zz_auto_ snapshots found on {remote_host}:{remote_ds}.", flush=True); return True
    latest = remote_snaps[0]
    try:
        res = subprocess.check_output(["ssh", "-o", "BatchMode=yes", remote_host,
                                       f"zfs get all -H -o property,value {remote_ds}"], encoding='utf-8')
        pairs = [l.split('\t', 1) for l in res.splitlines() if '\t' in l]
        remote_props = {p: v for p, v in pairs if p.startswith("zz:") and not p.startswith("zz:last_")}
    except subprocess.CalledProcessError:
        print(f"[!] Could not read properties of {remote_ds} on {remote_host}.", flush=True); return True
    # Send back the same way it was sent (e.g. raw for encrypted data)
    try: rflags = " ".join(parse_send_flags(remote_props.get("zz:send_flags")))
    except ValueError as e: print(f"[!] Remote zz:send_flags: {e}", flush=True); return True

    # The replica tree. Children deleted on the primary stay on the replica (zz never receives
    # with -F) but lack newer snapshots. ZFS refuses a recursive send unless every dataset in the
    # tree has the snapshot, even ones excluded with -X, so such children get a temporary
    # snapshot tagged zz:restore_temp, are excluded, and the temporary snapshot is removed once
    # the restore completes. The rest of the tree is what the primary looked like at @latest.
    stale, missing, expected, all_remote = [], [], [remote_ds], set()
    if not args.latest:
        try:
            kids = subprocess.check_output(zfs_on(remote_host, "list", "-H", "-o", "name", "-r", remote_ds),
                                           encoding='utf-8').split()
            res = subprocess.check_output(zfs_on(remote_host, "list", "-H", "-t", "snapshot", "-o", "name,zz:restore_temp",
                                                 "-r", remote_ds), encoding='utf-8')
        except subprocess.CalledProcessError:
            print(f"[!] Could not list {remote_ds} and its children on {remote_host}.", flush=True); return True
        snaps_temp = dict(l.split('\t') for l in res.splitlines() if l)
        all_remote = {n for n, t in snaps_temp.items() if t != "on"}
        have = {n.split('@')[0] for n in all_remote if n.endswith(f"@{latest}")}
        missing = [k for k in kids if k != remote_ds and k not in have]
        stale = [k for k in missing if not any(k.startswith(m + "/") for m in missing)]  # -X covers descendants
        expected = [k for k in kids if k not in missing]
        if stale:
            print(f"    [!] Not restoring {len(stale)} child dataset(s) that no longer exist on the primary "
                  f"(no @{latest}): {', '.join(stale)}\n"
                  f"        They remain on {remote_host} until they age out of retention. To recover files from one,\n"
                  f"        on {remote_host}: zfs mount <dataset>   (it's read-only; see also its .zfs/snapshot directory)", flush=True)
            for k in missing:
                if f"{k}@{latest}" not in snaps_temp:
                    subprocess.run(zfs_on(remote_host, "snapshot", "-o", "zz:restore_temp=on", f"{k}@{latest}"), check=True)
    exclude = f"-X {','.join(stale)}" if stale else ""
    local_name = lambda k: local_ds + k[len(remote_ds):]

    # 1. Finish an interrupted receive, if there is one
    try: token = subprocess.check_output(["zfs", "get", "-H", "-o", "value", "receive_resume_token", local_ds],
                                         encoding='utf-8', stderr=subprocess.DEVNULL).strip()
    except subprocess.CalledProcessError: token = "-"
    exists = subprocess.run(["zfs", "list", local_ds], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0
    if token != "-":
        print(f"[*] Resuming interrupted restore...", flush=True)
        if run_transfer(["ssh", remote_host, f"zfs send -v -t {token}"], recv_cmd) != 0:
            print("[!] Restore interrupted again. Run the same command to resume.", flush=True); return True
    elif exists:
        # Only continue into an existing dataset if it is an unfinished restore from this remote
        local_snaps = zz_snaps(local_ds)
        if ZzDataset(local_ds).props or not local_snaps or \
           snap_guid(f"{local_ds}@{local_snaps[0]}") != snap_guid(f"{remote_ds}@{local_snaps[0]}", remote_host):
            print(f"[!] {local_ds} already exists and is not a partial restore from {args.remote}. "
                  f"Refusing to overwrite it; rename or destroy it, or restore to another name.", flush=True)
            return True
        print(f"[*] Continuing partial restore (have @{local_snaps[0]})...", flush=True)
    else:
        mode = "latest snapshot only" if args.latest else "full history"
        print(f"[*] Restoring @{latest} ({mode})...", flush=True)
        send = f"zfs send {'-v' if args.latest else '-R -v'} {exclude} {rflags} {remote_ds}@{latest}"
        if run_transfer(["ssh", remote_host, send], recv_cmd) != 0:
            print("[!] Restore interrupted. Run the same command to resume.", flush=True); return True

    # 2. Bring every dataset in the tree up to @latest. A resumed stream only completes the
    #    snapshot in flight, and a recursive catch-up fails (or skips) children that don't exist
    #    here yet. So, parents first: a missing dataset is created with a recursive send of its
    #    subtree; an existing one that's behind is caught up on its own.
    for k in expected:
        lk = local_name(k)
        try: have_local = zz_snaps(lk)
        except subprocess.CalledProcessError: have_local = None     # not here yet
        if have_local and have_local[0] == latest: continue
        sub_ex = [x for x in stale if x.startswith(k + "/")]
        ex = f"-X {','.join(sub_ex)}" if sub_ex else ""
        base = "-v" if args.latest else f"-R -v {ex}"   # recursive, for creating a missing subtree
        if not have_local:
            if have_local is not None:   # exists but has no zz snapshots: not something zz restored
                print(f"[!] {lk} exists but has no zz snapshots; move it aside and run restore again.", flush=True); return True
            print(f"[*] Restoring missing {lk}...", flush=True)
            send = f"zfs send {base} {rflags} {k}@{latest}"
        else:
            if not args.latest and f"{k}@{have_local[0]}" not in all_remote and k != remote_ds:
                print(f"[!] {lk}@{have_local[0]} not found on the remote; cannot continue.", flush=True); return True
            if k == remote_ds and have_local[0] not in remote_snaps:
                print(f"[!] Local @{have_local[0]} not found on remote; cannot continue.", flush=True); return True
            # Flags must come before -i/-I, which takes the next argument as its snapshot
            print(f"[*] Catching up {lk} @{have_local[0]} -> @{latest}...", flush=True)
            send = f"zfs send -v {rflags} {'-i' if args.latest else '-I'} @{have_local[0]} {k}@{latest}"
        if run_transfer(["ssh", remote_host, send], ["zfs", "recv", "-s", "-u", lk]) != 0:
            print("[!] Restore interrupted. Run the same command to resume.", flush=True); return True
    behind = []
    for k in expected:
        try:
            if zz_snaps(local_name(k))[:1] != [latest]: behind.append(local_name(k))
        except subprocess.CalledProcessError: behind.append(local_name(k))
    if behind:
        print(f"[!] Restore incomplete: not at @{latest}: {', '.join(behind)}. Run the same command again.", flush=True)
        return True

    # Remove the temporary snapshots from stale children (before holds are placed on @latest)
    for k in missing:
        subprocess.run(zfs_on(remote_host, "destroy", f"{k}@{latest}"), stderr=subprocess.DEVNULL)

    # 3. Make it a live, managed primary again (unless another dataset already replicates there)
    subprocess.run(["zfs", "set", "readonly=off", local_ds])
    res = subprocess.check_output(["zfs", "list", "-H", "-o", "name,canmount", "-r", local_ds], encoding='utf-8')
    for n, canmount in (l.split('\t') for l in res.splitlines() if l):
        if n == local_ds or canmount == "noauto": subprocess.run(["zfs", "set", "canmount=on", n])
    owners = [n for n in (get_managed_datasets() or []) if n != local_ds and ZzDataset(n).target == args.remote]
    if not owners:
        ds = ZzDataset(local_ds)
        for pk, pv in remote_props.items(): ds.set_prop(pk.split(':', 1)[1], pv)
        ds.set_prop("target", args.remote); ds.set_prop("last_sync", int(time.time())); ds.record_sent(latest)
        for host, path in ((None, local_ds), (remote_host, remote_ds)):
            err = pin_bridge(path, latest, host)
            if err: print(f"    [!] {err}", flush=True)
    res = subprocess.check_output(["zfs", "list", "-H", "-o", "name,canmount,mounted,keystatus", "-r", local_ds], encoding='utf-8')
    locked = []
    for n, canmount, mounted, keystatus in (l.split('\t') for l in res.splitlines() if l):
        if keystatus == "unavailable": locked.append(n); continue
        if canmount == "off" or mounted == "yes": continue
        if subprocess.run(["zfs", "mount", n], stderr=subprocess.DEVNULL).returncode != 0:
            print(f"    [!] Could not mount {n}; check its mountpoint.", flush=True)
    if locked:
        # A raw (encrypted) restore arrives locked, with keylocation reset to prompt
        print(f"    [!] {local_ds} is encrypted and its key isn't loaded, so it wasn't mounted. Load it with:\n"
              f"          zfs load-key {local_ds}      (or: zfs load-key -L file:///path/to/key {local_ds})\n"
              f"          zfs mount -a\n"
              f"        and set keylocation if it should load automatically at boot.", flush=True)
    if owners:
        print(f"[+] Restore complete at @{latest}. {owners[0]} already replicates to {args.remote}, "
              f"so {local_ds} was left unmanaged (use 'zz init' to replicate it elsewhere).", flush=True)
    else:
        print(f"[+] Restore complete at @{latest}. Replication to {args.remote} will resume on the next sync.", flush=True)

def replication_state(ds, now):
    """(status, lag_seconds or None). Lag is the age of the newest snapshot confirmed on the remote."""
    try: freq_sec = ds_duration(ds, "freq", "60m")
    except ValueError: return "ERROR", None
    if ds.last_sync == 0: return "INIT", None
    if ds.last_error: return "ERROR", (now - ds.last_sent if ds.last_sent else None)
    if not ds.last_sent: return "UNKNOWN", None
    lag = now - ds.last_sent
    if lag > max(86400, 4 * freq_sec): return "STALLED", lag
    # One interval plus cron granularity is normal; allow two before flagging
    if lag > 2 * freq_sec + 300: return "LAGGING", lag
    return "OK", lag

def print_status_table(names):
    """Status rows for these datasets, then any errors. Returns True if any is unhealthy."""
    print(f"{'DATASET':<20} | {'STATUS':<8} | {'LAST SNAP':<18} | {'LAG':<16} | {'NEXT SNAP'}", flush=True)
    print("-" * 90, flush=True)
    unhealthy, errors = False, []
    now = int(time.time())
    for name in names:
        ds = ZzDataset(name)
        status, lag = replication_state(ds, now)
        lag_str = fmt_age(lag) if lag is not None else "-"
        if ds.last_sync == 0:
            last_str, next_run = "NEVER", "PENDING"
        else:
            gap = now - ds.last_sync
            last_str = "UNKNOWN" if gap > 86400 * 365 else fmt_age(gap) + " ago"
            try:
                freq_sec = ds_duration(ds, "freq", "60m")
                next_run = "DUE NOW" if gap >= freq_sec else fmt_age(freq_sec - gap)
            except ValueError as e:
                next_run = "-"
                if not ds.last_error: errors.append(f"  {name}: {e}")
        print(f"{name:<20} | {status:<8} | {last_str:<18} | {lag_str:<16} | {next_run}", flush=True)
        if status not in ("OK", "INIT", "UNKNOWN"): unhealthy = True
        if ds.last_error:
            ts, _, msg = ds.last_error.partition(' ')
            when = datetime.datetime.fromtimestamp(int(ts)).strftime('%Y-%m-%d %H:%M:%S') if ts.isdigit() else "?"
            errors.append(f"  {name} @ {when}: {msg}")
    if errors: print("\nLast errors:\n" + "\n".join(errors), flush=True)
    notes = [(n, ZzDataset(n).props.get("zz:stale_children", "-")) for n in names]
    notes = [f"  {n}: the replica still has {v.replace(',', ', ')} (deleted here); recoverable there until it ages out"
             for n, v in notes if v != "-"]
    if notes: print("\nNotes:\n" + "\n".join(notes), flush=True)
    return unhealthy

def run_status(args):
    print(f"zz {get_version()}\n", flush=True)
    managed = get_managed_datasets()
    if managed is None: return True
    if not managed: print("No managed datasets.", flush=True); return
    return print_status_table(managed)

def snap_table(dataset, host=None):
    """{tag: (creation, used, written)} for zz_auto_ snapshots of exactly this dataset, plus
    the dataset's usedbysnapshots. Raises CalledProcessError on failure."""
    cmd = ["zfs", "list", "-t", "snapshot", "-H", "-p", "-o", "name,creation,used,written", dataset]
    ubs = ["zfs", "get", "-H", "-p", "-o", "value", "usedbysnapshots", dataset]
    if host:
        cmd = ["ssh", "-o", "BatchMode=yes", host] + cmd
        ubs = ["ssh", "-o", "BatchMode=yes", host] + ubs
    rows = {}
    for line in subprocess.check_output(cmd, encoding='utf-8', stderr=subprocess.DEVNULL).splitlines():
        name, creation, used, written = line.split('\t')
        if "@zz_auto_" in name:
            rows[name.split('@', 1)[1]] = (int(creation), int(used), int(written) if written.isdigit() else None)
    held = subprocess.check_output(ubs, encoding='utf-8', stderr=subprocess.DEVNULL).strip()
    return rows, int(held) if held.isdigit() else None

def run_snaps(args):
    name = args.dataset
    if not name:
        managed = get_managed_datasets()
        if managed is None: return True
        if len(managed) != 1:
            print("[!] Specify a dataset: " + (", ".join(managed) if managed else "no managed datasets"), flush=True)
            return True
        name = managed[0]
    ds = managed_dataset(name)
    if not ds: return True
    try: remote_host, remote_path = parse_target(ds.target)
    except ValueError as e: print(f"[!] {e}", flush=True); return True

    print(f"zz {get_version()}   {name} -> {ds.target}\n", flush=True)
    try: local, local_held = snap_table(name)
    except subprocess.CalledProcessError:
        print(f"[!] Could not list local snapshots of {name}.", flush=True); return True
    try: remote, remote_held = snap_table(remote_path, remote_host); remote_ok = True
    except subprocess.CalledProcessError:
        remote, remote_held, remote_ok = {}, None, False

    try: held_l = held_bridges(name)
    except subprocess.CalledProcessError: held_l = set()
    try: held_r = held_bridges(remote_path, remote_host) if remote_ok else set()
    except subprocess.CalledProcessError: held_r = set()
    both = [t for t in local if t in remote]
    bridge = max(both, key=lambda t: local[t][0]) if both else None
    tags = sorted(set(local) | set(remote), key=lambda t: (local.get(t) or remote[t])[0], reverse=True)
    shown = tags if args.all else tags[:args.limit]

    print(f"{'SNAPSHOT (local time)':<21} | {'GAP':>8} | {'WRITTEN':>8} | {'LOCAL USED':>10} | {'REMOTE USED':>11} | STATE", flush=True)
    print("-" * 90, flush=True)
    for i, t in enumerate(shown):
        creation, _, written = local.get(t) or remote[t]
        older = tags[i + 1] if i + 1 < len(tags) else None
        gap = fmt_gap(creation - (local.get(older) or remote[older])[0]) if older else "-"
        if not remote_ok: state = "?"
        elif t in local and t in remote: state = "both"
        elif t in local: state = "pending" if bridge is None or creation > local[bridge][0] else "local only"
        else: state = "remote only"
        if t == bridge:
            sides = [n for n, h in (("local", held_l), ("remote", held_r)) if t in h]
            state += "  <- bridge" + (", held " + " + ".join(sides) if sides else ", NOT held")
        when = datetime.datetime.fromtimestamp(creation).strftime('%Y-%m-%d %H:%M')
        lu = human_bytes(local[t][1]) if t in local else "-"
        ru = human_bytes(remote[t][1]) if t in remote else ("?" if not remote_ok else "-")
        wr = human_bytes(written) if written is not None else "-"
        print(f"{when:<21} | {gap:>8} | {wr:>8} | {lu:>10} | {ru:>11} | {state}", flush=True)
    if len(shown) < len(tags):
        print(f"... {len(tags) - len(shown)} older snapshot(s) not shown (--all to show everything)", flush=True)

    def summary(label, rows, held):
        if not rows: return f"{label:<7} no zz snapshots"
        oldest = datetime.datetime.fromtimestamp(min(r[0] for r in rows.values())).strftime('%Y-%m-%d %H:%M')
        held_str = f"{human_bytes(held)} held by snapshots" if held is not None else "snapshot space unknown"
        return f"{label:<7} {len(rows)} snapshots, {held_str}, oldest {oldest}"
    print("\n" + summary("LOCAL", local, local_held), flush=True)
    stale = ds.props.get("zz:stale_children", "-")
    if stale != "-":
        print(f"NOTE    the replica still has child dataset(s) deleted here: {stale.replace(',', ', ')}; "
              f"recoverable there until they age out of retention", flush=True)
    if remote_ok: print(summary("REMOTE", remote, remote_held), flush=True)
    else:
        print(f"REMOTE  [!] could not list snapshots on {remote_host}:{remote_path}; showing local side only", flush=True)
        return True

def run_meta(args):
    ds = managed_dataset(args.dataset)
    if not ds: return True
    print(f"\n[ zz Contract: {args.dataset} ]", flush=True)
    print(f"{'DESCRIPTION':<22} | {'KEY':<12} | {'VALUE'}", flush=True)
    print("-" * 65, flush=True)
    fields = [('Remote Target','target','zz:target'), ('Sync Frequency','freq','zz:freq'), 
              ('Local Retention','keep_local','zz:keep_local'), ('Remote Retention','keep_remote','zz:keep_remote'),
              ('Safety Floor (Min)','keep_min','zz:keep_min'), ('Send Flags','send_flags','zz:send_flags')]
    for d, k, p in fields:
        val = ds.props.get(p, "-")
        if k == 'send_flags' and val == "-": val = "none (set up before zz 0.5)"
        if k in ['freq', 'keep_local', 'keep_remote'] and val != "-":
            try: val = human_duration(parse_duration(val))
            except ValueError: val = f"{val} (INVALID)"
        print(f"{d:<22} | {k:<12} | {val}", flush=True)

def run_set(args):
    args.value = " ".join(args.value).strip()
    if not args.value: print("[!] Not updated: a value is required.", flush=True); return True
    ds = ZzDataset(args.dataset)
    if ds.props is None:
        print(f"[!] Error: Dataset '{args.dataset}' not found.", flush=True); return True
    try:
        if args.prop in ('freq', 'keep_local', 'keep_remote'): parse_duration(args.value)
        elif args.prop == 'keep_min': keep_min_arg(args.value)
        elif args.prop == 'target': parse_target(args.value)
        elif args.prop == 'send_flags': parse_send_flags(args.value)
    except (ValueError, argparse.ArgumentTypeError) as e:
        print(f"[!] Not updated: {e}", flush=True); return True
    ds.set_prop(args.prop, args.value); print(f"[*] Updated {args.prop} to {args.value}", flush=True)
    if args.prop == 'send_flags':
        print("    Note: if the next sync fails with a message about flags not matching a previous receive,\n"
              "    set send_flags back to its old value.", flush=True)

def run_abort(args):
    ds = managed_dataset(args.dataset)
    if not ds: return True
    try: remote_host, remote_path = parse_target(ds.target)
    except ValueError as e: print(f"[!] {e}", flush=True); return True
    if get_token(remote_host, remote_path) == "-":
        print(f"[*] No interrupted transfer on {remote_host}:{remote_path}; nothing to abort.", flush=True); return
    if subprocess.run(["ssh", "-o", "BatchMode=yes", remote_host, f"zfs recv -A {remote_path}"]).returncode != 0:
        print("[!] Could not clear the resume token.", flush=True); return True
    print("[+] Resume token cleared.", flush=True)

class QuietPipe:
    """stdout wrapper: if the reader goes away (zz snaps | head), discard further output instead
    of raising BrokenPipeError. Work in progress (a sync, a restore) carries on to completion."""
    def __init__(self, stream): self.stream, self.closed_pipe = stream, False
    def _discard(self):
        self.closed_pipe = True
        try: os.dup2(os.open(os.devnull, os.O_WRONLY), self.stream.fileno())
        except OSError: pass
    def write(self, text):
        if not self.closed_pipe:
            try: return self.stream.write(text)
            except BrokenPipeError: self._discard()
        return len(text)
    def flush(self):
        if not self.closed_pipe:
            try: self.stream.flush()
            except BrokenPipeError: self._discard()
    def __getattr__(self, name): return getattr(self.stream, name)

def main():
    sys.stdout = QuietPipe(sys.stdout)
    parser = argparse.ArgumentParser(prog='zz', description='Zeasy: Simplified ZFS Replication', formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="Durations: 30m, 1h, 7d, 2w, 1y (a bare number means minutes).\n\n"
               "Examples:\n  zz init tank/data backup:pool/data --freq 1h\n  zz status\n  zz restore backup:pool/data tank/data")
    parser.add_argument('--version', action='version', version=f"zz {get_version()}")
    subparsers = parser.add_subparsers(title='Commands', dest='command', metavar='<command>')
    pi = subparsers.add_parser('init', help='Start replicating a dataset: <dataset> <host:pool/dataset> [--freq] [--keep-local] [--keep-remote] [--keep-min]')
    pi.add_argument('dataset'); pi.add_argument('remote')
    pi.add_argument('--freq', default='60m', type=duration_arg); pi.add_argument('--keep-local', default='7d', type=duration_arg)
    pi.add_argument('--keep-remote', default='30d', type=duration_arg); pi.add_argument('--keep-min', default='10', type=keep_min_arg)
    pi.add_argument('--send-flags', type=send_flags_arg,
                    help="zfs send flags (default: -w for encrypted datasets, otherwise -L -c; 'none' for plain sends)")
    pi.set_defaults(func=run_init)
    ps = subparsers.add_parser('sync', help='Snapshot if due and send to the remote: [dataset] [--now]',
                               description='Take a snapshot if one is due, send any unsent snapshots, and prune.')
    ps.add_argument('dataset', nargs='?', help='only this dataset (default: all managed datasets)')
    ps.add_argument('--now', '--force', dest='force', action='store_true',
                    help="take a snapshot now even if one isn't due. It doesn't move the schedule, and "
                         "locks, busy checks and errors still apply; the remote is never overwritten.")
    ps.set_defaults(func=run_sync)
    subparsers.add_parser('status', help='Replication health of all managed datasets').set_defaults(func=run_status)
    pn = subparsers.add_parser('snaps', help='Snapshots on both sides with sizes: [dataset] [--limit N] [--all]',
                               description='List zz snapshots on the local and remote side, newest first. WRITTEN is the data '
                                           'changed in that interval (about the size of its send); USED is the space deleting '
                                           'that one snapshot would free.')
    pn.add_argument('dataset', nargs='?', help='managed dataset (optional if only one is managed)')
    pn.add_argument('--limit', type=int, default=24, help='newest N snapshots to show (default 24)')
    pn.add_argument('--all', action='store_true', help='show every snapshot')
    pn.set_defaults(func=run_snaps)
    pm = subparsers.add_parser('meta', help='Show a dataset\'s settings: <dataset>'); pm.add_argument('dataset'); pm.set_defaults(func=run_meta)
    pset = subparsers.add_parser('set', help='Change a setting: <dataset> <prop> <value>'); pset.add_argument('dataset'); pset.add_argument('prop', choices=['target', 'freq', 'keep_local', 'keep_remote', 'keep_min', 'send_flags']); pset.add_argument('value', nargs=argparse.REMAINDER, help="new value (e.g. 7d, or send flags such as -L -c)"); pset.set_defaults(func=run_set)
    pa = subparsers.add_parser('abort', help='Discard an interrupted transfer on the remote: <dataset>'); pa.add_argument('dataset'); pa.set_defaults(func=run_abort)
    pf = subparsers.add_parser('forget', help='Stop managing a dataset (data is kept): <dataset>'); pf.add_argument('dataset'); pf.set_defaults(func=run_forget)
    pr = subparsers.add_parser('restore', help='Recreate a dataset from the remote: <host:pool/dataset> <dataset> [--latest]'); pr.add_argument('remote'); pr.add_argument('local_dataset'); pr.add_argument('--latest', action='store_true'); pr.set_defaults(func=run_restore)
    args = parser.parse_args()
    if not hasattr(args, 'func'): parser.print_help(); return
    if args.func(args): sys.exit(1)

if __name__ == "__main__": main()
